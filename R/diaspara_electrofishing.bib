
@incollection{zalewski_factors_1990,
	address = {Oxford},
	title = {Factors affecting electric fishing efficiency},
	abstract = {Fish catchabilibty declines during successive sampling In turbid waters, quantitative estimate of fish density and biomas, with anay type of electric current are impossible as pygoot et al. 1990 found on a turbid canal in UK In rivers, the most important characeristic affecting electrofishing efficiency is channel width. Wtaer velocity will affect the performance of the fishing operatot and also the ease with which fishes are caught Experiments on such specific bodu hapes as european eel (Anguilla anguilla) however did did not hold this relationship, eels tend to be more easily immobilized than trout, and size eeffect was not observed The desnity of fish population can modifiy fishing efficiency More diversified habitats have a greater carrying capacity and therefore higher density of fish but a reduced sampling efficiency Probability of capture is the probability of fish being caught during each sweep of the survey area. Efficiency is that proportion of fish which are caught in the first sweep as a proportion of the total estiated population size determined when the survey is finished.},
	booktitle = {Fishing with electricity, applications in freshwater fisheries management},
	publisher = {Blackwell},
	author = {Zalewski, M. and Cowx, I.G.},
	editor = {Cowx, I. G. and Lamarque, P.},
	year = {1990},
	keywords = {electrofishing},
	pages = {89--111},
}

